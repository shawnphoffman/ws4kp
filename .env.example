# =============================================================================
# ws4kp Environment Variables
# =============================================================================
# Copy this file to .env and customize as needed.
# All variables are optional — defaults are used when not set.

# =============================================================================
# APP BRANDING
# =============================================================================
# Override the app title shown in the browser tab, loading screen, manifest,
# meta tags, and keywords.
# APP_TITLE=My Custom Weather

# Override the meta description tag.
# APP_DESCRIPTION=A custom weather display application

# Override the meta author tag.
# APP_AUTHOR=Your Name

# Override the Open Graph image URL (used for social media previews).
# APP_OG_IMAGE=https://example.com/images/social/preview.png

# Override the "More information" link URL shown below the display.
# APP_INFO_URL=https://github.com/your-username/your-repo

# Override the corner logo on all display screens.
# Can be a relative path (to /app/server/) or an absolute URL.
# APP_LOGO_URL=images/logos/custom-logo.png

# =============================================================================
# CUSTOM TRAVEL CITIES
# =============================================================================
# Path to a JSON file containing custom travel cities. The file should be an
# array of objects with Name, Latitude, and Longitude fields:
#
#   [
#     {"Name": "Portland", "Latitude": 45.5152, "Longitude": -122.6784},
#     {"Name": "Nashville", "Latitude": 36.1627, "Longitude": -86.7816}
#   ]
#
# NOAA grid point data (wfo, x, y) is automatically fetched at startup
# for any cities that don't already have a "point" field.
#
# In Docker, mount the file as a volume:
#   -v /path/to/my-cities.json:/app/data/travel-cities.json
# TRAVEL_CITIES_FILE=/app/data/travel-cities.json

# How custom cities are merged with the defaults:
#   append  - (default) adds custom cities after the built-in list
#   override - replaces the built-in list entirely
# TRAVEL_CITIES_MODE=append

# =============================================================================
# WSQS — Query String Injection
# =============================================================================
# WSQS_* env vars inject URL query parameters on first page load via a 307
# redirect. This controls display settings, enabled screens, and more.
#
# HOW IT WORKS:
#   1. Strip the WSQS_ prefix
#   2. Convert remaining underscores to hyphens
#   3. Append as query string parameters
#
# Example: WSQS_settings_wide_checkbox=true → ?settings-wide-checkbox=true
#
# TIP: Use the "Copy Permalink" sharing feature in the app to generate a
# starting point, then convert each query param to a WSQS_ env var by
# replacing hyphens with underscores and adding the WSQS_ prefix.
#
# IMPORTANT: Use underscores only — hyphens in env var names will be silently
# ignored.

# --- Location (pick one) ---
# Pre-fill the location search box (does not auto-load weather data):
# WSQS_txtLocation=South Lake Tahoe, CA, USA

# Auto-load weather data for a location on page load:
# WSQS_latLonQuery=South Lake Tahoe, CA, USA

# Auto-load weather data by exact coordinates (lat,lon):
# WSQS_latLon=38.9416,-119.9772

# --- Display Toggles ---
# Enable or disable individual weather display screens (true/false).
# WSQS_hazards_checkbox=true
# WSQS_current_weather_checkbox=true
# WSQS_latest_observations_checkbox=true
# WSQS_hourly_checkbox=true
# WSQS_hourly_graph_checkbox=true
# WSQS_travel_checkbox=true
# WSQS_regional_forecast_checkbox=true
# WSQS_local_forecast_checkbox=true
# WSQS_extended_forecast_checkbox=true
# WSQS_almanac_checkbox=true
# WSQS_spc_outlook_checkbox=true
# WSQS_radar_checkbox=true

# --- Settings ---
# Widescreen mode (854x480 instead of 640x480):
# WSQS_settings_wide_checkbox=true

# Kiosk mode (hides controls, auto-plays on load):
# WSQS_settings_kiosk_checkbox=false

# Sticky kiosk (persists kiosk mode across refreshes):
# WSQS_settings_stickyKiosk_checkbox=false

# Carousel speed multiplier (0.5 = fast, 1.0 = normal, 2.0 = slow):
# WSQS_settings_speed_select=1.00

# Units: "us" (Fahrenheit/mph) or "si" (Celsius/km/h):
# WSQS_settings_units_select=us

# Scanlines: enable the CRT scanline overlay:
# WSQS_settings_scanLines_checkbox=false

# Scanline mode: "auto", "on", or "off":
# WSQS_settings_scanLineMode_select=auto

# Background music volume (0.00 to 1.00):
# WSQS_settings_mediaVolume_select=0.75

# Custom scroll text (scrolling ticker at the bottom):
# WSQS_settings_customTextEnable_checkbox=false
# WSQS_settings_customText_string=Your custom message here

# =============================================================================
# OVERRIDE_* — Client-Side Overrides
# =============================================================================
# OVERRIDE_* env vars are passed directly to the client as-is (prefix stripped).
# These are used by the upstream project for specific client-side overrides.
# See the upstream README for available keys.

# =============================================================================
# MUSIC
# =============================================================================
# Custom music is added via Docker volume mount, not env vars.
# Only .mp3 format is supported. The playlist is generated dynamically at
# /playlist.json.
#
# OPTION 1: Add music (keeps built-in tracks)
#   Mount .mp3 files to /app/server/add-music/:
#   docker run -v /path/to/extra-music:/app/server/add-music ghcr.io/you/ws4kp
#   Your tracks are appended to the default playlist.
#
# OPTION 2: Replace music (overrides built-in tracks)
#   Mount .mp3 files to /app/server/music/:
#   docker run -v /path/to/my-music:/app/server/music ghcr.io/you/ws4kp
#   Only your tracks are used. The built-in defaults are skipped.
#
# If neither mount has .mp3 files, the 4 built-in default tracks are used.

# =============================================================================
# BACKGROUND IMAGES
# =============================================================================
# Custom backgrounds are added via Docker volume mount:
#
#   docker run -v /path/to/backgrounds:/app/server/images/backgrounds ghcr.io/you/ws4kp
#
# Expected files: 1.png, 1-wide.png, 1-chart.png, 2.png, 3.png, 4.png,
#                 4-wide.png, 5.png, 6.png, 7.png, 7-wide.png

# =============================================================================
# SERVER
# =============================================================================
# Port the server listens on (default: 8080):
# WS4KP_PORT=8080

# Timezone (used by the container OS, not the weather display):
# TZ=America/Los_Angeles
